# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and anon public key to connect live database & Auth
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# RAZORPAY PAYMENT GATEWAY (Test Mode):
# Get your Key ID from Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"

# COLLEGE SETTINGS:
# Optional approved college email domain e.g. "campus.edu"
VITE_COLLEGE_EMAIL_DOMAIN="campus.edu"
